# Dependencies — never commit
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.output/

# Environment files — NEVER commit real keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel local dev
.vercel/

# Editor / OS artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build info
*.tsbuildinfo

# Test coverage
coverage/

# Temporary uploads — documents must NEVER be committed
uploads/
*.pdf
