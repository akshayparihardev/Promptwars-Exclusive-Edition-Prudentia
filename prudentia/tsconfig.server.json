{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": ".vercel/output/functions",
    "rootDir": "."
  },
  "include": ["api/**/*.ts", "src/logic/**/*.ts", "src/data/**/*.ts"]
}
